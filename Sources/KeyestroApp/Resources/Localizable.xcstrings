            "value": "Keyestro 的快捷键必须互不相同。"
          }
        }
      }
    },
    "Keyestro will copy the selected executable only if its SHA-256 matches the exported registration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
