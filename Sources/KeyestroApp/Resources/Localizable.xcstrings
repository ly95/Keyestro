          }
        }
      }
    },
    "Keyestro keeps only bounded timing samples in memory. Queries, result titles, clipboard content, and file paths are never recorded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyestro 只在内存中保留有界的计时样本，绝不记录查询、结果标题、剪贴板内容或文件路径。"
          }
        }
      }
    },
    "Keyestro remains available from the menu bar when the Dock icon is hidden.": {
      "localizations": {
