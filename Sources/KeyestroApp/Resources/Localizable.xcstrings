{
  "sourceLanguage": "en",
  "strings": {
    "%arg non-secret settings merged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已合并 %arg 项非敏感设置"
          }
        }
      }
    },
    "%arg quick links added · %arg replaced": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$arg quick links added · %2$arg replaced"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 %arg 个快捷链接 · 替换 %arg 个"
          }
        }
      }
    },
    "%arg scripts require reconnection · %arg extensions require reinstallation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$arg scripts require reconnection · %2$arg extensions require reinstallation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%arg 个脚本需要重新连接 · %arg 个扩展需要重新安装"
          }
        }
      }
    },
    "%arg scripts still require reconnection · %arg extensions still require reinstallation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$arg scripts still require reconnection · %2$arg extensions still require reinstallation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%arg 个脚本仍需重新连接 · %arg 个扩展仍需重新安装"
          }
        }
      }
    },
    "%arg unsupported settings ignored": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已忽略 %arg 项不支持的设置"
